{
  "name": "web",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "d": "npm run develop",
    "c": "npm run check",
    "a": "npm run .shadcn-ui.add",
    "v": "npm run .vite.clean-cache",
    "u": "npm install lucide-react@latest",
    "start": "serve -s -l 7001 ./dist",
    "preview": "cross-env VITE_TARGET=local vite preview --port=7001",
    "develop": "cross-env VITE_TARGET=local vite dev --port=7001",
    ".shadcn-ui.add": "shadcn-ui add",
    ".vite.clean-cache": "rimraf ./node_modules/.vite",
    "build:local": "cross-env VITE_TARGET=local npm run .build",
    "build:stage": "cross-env VITE_TARGET=stage npm run .build",
    "build:live": "cross-env VITE_TARGET=live npm run .build",
    ".build": "tsc && vite build",
    "check": "tsc --noEmit",
    "postinstall": "patch-package",
    "version": "node ./scripts/capture-version.cjs",
    "browserslist": "browserslist",
    "test": "echo \"No test yet, but keep the script for CI/CD pipelines.\""
  },
  "engines": {
    "node": ">=22.14.0",
    "npm": ">=10.9.2"
  },
  "keywords": [
    "hosna",
    "web"
  ],
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.0.4",
    "@radix-ui/react-avatar": "^1.0.3",
    "@radix-ui/react-checkbox": "^1.0.4",
    "@radix-ui/react-dialog": "^1.0.4",
    "@radix-ui/react-dropdown-menu": "^2.0.5",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-menubar": "^1.0.3",
    "@radix-ui/react-navigation-menu": "^1.1.4",
    "@radix-ui/react-popover": "^1.0.6",
    "@radix-ui/react-progress": "^1.0.3",
    "@radix-ui/react-radio-group": "^1.1.3",
    "@radix-ui/react-scroll-area": "1.0.5",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-separator": "^1.0.3",
    "@radix-ui/react-slider": "^1.2.0",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-switch": "^1.0.3",
    "@radix-ui/react-toast": "^1.1.4",
    "@radix-ui/react-toggle": "^1.0.3",
    "@radix-ui/react-toggle-group": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.0.6",
    "@tailwindcss/typography": "^0.5.11",
    "@types/color": "^3.0.2",
    "@types/node": "^22.13.4",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/react-helmet": "^6.1.5",
    "@types/uuid": "^10.0.0",
    "change-case": "^5.4.4",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "color": "^3.2.1",
    "cross-env": "^7.0.3",
    "date-fns": "^4.1.0",
    "es5-shim": "^4.6.7",
    "es6-shim": "^0.35.8",
    "lucide-react": "^0.468.0",
    "patch-package": "^8.0.0",
    "react": "^18.2.0",
    "react-day-picker": "^9.6.1",
    "react-dom": "^18.2.0",
    "react-helmet": "^6.1.0",
    "react-router-dom": "^6.15.0",
    "react-use": "^17.2.4",
    "resize-observer-polyfill": "^1.5.1",
    "serve": "^14.2.4",
    "shared": "file:../shared",
    "tailwind-merge": "^1.14.0",
    "tailwindcss-animate": "^1.0.6",
    "tippy.js": "^6.3.7",
    "tus-js-client": "^3.1.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react-swc": "^3.8.0",
    "autoprefixer": "^10.4.15",
    "postcss": "^8.4.29",
    "postcss-nesting": "^12.0.1",
    "rimraf": "^6.0.1",
    "shadcn-ui": "^0.8.0",
    "tailwindcss": "^3.3.3",
    "typescript": "^5.7.3",
    "vite": "^6.1.1"
  }
}
