  "main": "./src/index.ts",
  "scripts": {
    "d": "npm run develop",
    "c": "npm run check",
    "p": "npx prisma format && npx prisma migrate dev --name",
    "u": "npm install prisma@latest @prisma/client@latest ai@latest @ai-sdk/anthropic@latest @ai-sdk/google@latest @ai-sdk/groq@latest @ai-sdk/openai@latest",
    "start": "ts-node ./src/index.ts",
    "develop": "node-dev ./src/index.ts",
    "check": "tsc --noEmit",
    "postinstall": "npx playwright install && npx patch-package",
    "test": "echo \"No test yet, but keep the script for CI/CD pipelines.\""
